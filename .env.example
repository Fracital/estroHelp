# Server
HOST=127.0.0.1
PORT=3000
DEBUG=false
STATIC_DIR=frontend/dist
DATABASE_URL=postgres://kali:kali@172.16.8.8:5433/elichat

# Public host (host[:port]) of this deployment, so the in-chat shell's relay may
# call Estro's own API (e.g. estro.help). Loopback is allowed automatically.
PUBLIC_HOST=estro.help
# Signs short-lived two-factor login tokens. Random per start when unset; set it so restarts do not invalidate an in-progress sign-in.
SESSION_SECRET=
# First admin: this username is granted admin on startup once it exists.
ADMIN_USERNAME=
# Chat is gated behind a verified email address (admins exempt).
REQUIRE_VERIFIED_EMAIL=true
# Per-user daily chat requests; 0 disables. Admins and sandbox users are exempt.
DAILY_REQUEST_LIMIT=300
# Per-minute rate limits as "perMinute" or "perMinute,burst"; 0 disables a tier.
# Auth is per IP (sign-in, register, reset). LLM is per account for /v1 and is
# sized for agent loops. App covers the rest of /api (threads, account, admin).
RATE_AUTH=10,10
RATE_LLM=120,120
RATE_APP=300,300

# Billing (Stripe). Plans, prices and caps live in internal/billing/plans.go; see docs/billing.md.
# Public origin used in Checkout and portal return URLs. Falls back to https://PUBLIC_HOST.
PUBLIC_URL=https://estro.help
# false closes checkout for everyone except sandbox accounts; existing plans keep working.
SALES_OPEN=true
# Live mode. Unset (or CHANGE_ME) disables checkout with a 503 and ignores webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Billing portal configuration id (bpc_...). Required for POST /api/stripe/portal.
STRIPE_PORTAL_CONFIGURATION=
# One recurring price per plan and period (price_...).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=
# Sandbox mode, used for accounts flagged sandbox: the same names with a STRIPE_SANDBOX_ prefix.
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_SANDBOX_PORTAL_CONFIGURATION=
STRIPE_SANDBOX_PRICE_STARTER_MONTHLY=
STRIPE_SANDBOX_PRICE_STARTER_ANNUAL=
STRIPE_SANDBOX_PRICE_PLUS_MONTHLY=
STRIPE_SANDBOX_PRICE_PLUS_ANNUAL=
STRIPE_SANDBOX_PRICE_PRO_MONTHLY=
STRIPE_SANDBOX_PRICE_PRO_ANNUAL=
STRIPE_SANDBOX_PRICE_MAX_MONTHLY=
STRIPE_SANDBOX_PRICE_MAX_ANNUAL=
STRIPE_SANDBOX_PRICE_ULTRA_MONTHLY=
STRIPE_SANDBOX_PRICE_ULTRA_ANNUAL=

# Kali Gamma (kimi-k3) and Kali Beta (kimi-k2.8) via cliproxyapi
CLIPROXY_BASE_URL=https://chat.eli.gift/cpa
CLIPROXY_API_KEY=

# Kali Epsilon (GLM via chat.z.ai). See internal/zai for the full ZAI_* list.
ZAI_DISABLED=false
ZAI_TRANSPORT=patchright
ZAI_BROWSER_POOL_SIZE=2
ZAI_TOKEN=
ZAI_CONFIG_FILE=zai_config.json
# Characters of prose the z.ai worker buffers before streaming (tool-call guard). Default 2000 hides streaming on short replies.
ZAI_STREAM_HOLD=160
ZAI_EXT_TOKEN=

# Outbound mail for verification and password reset. Unset = codes are logged.
# Port 465 = implicit TLS (SMTP_SECURE=true); 587 = STARTTLS. Unset host = codes are logged.
SMTP_HOST=mail2.caan.edu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@caan.edu
SMTP_PASS=
# Local relay without credentials (e.g. postfix on 127.0.0.1:25): set SMTP_NOAUTH=true.
SMTP_NOAUTH=false
# Header From. The envelope sender is always SMTP_USER when authenticating, since relays reject other mailboxes.
SMTP_FROM=Estro <noreply@caan.edu>
