---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import FxBackground from '../components/fx/FxBackground';
import { HEAD_SCRIPT } from '../lib/preferences';
import '../styles/fx.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  fullscreen?: boolean;
}
const { title, description = 'Estro: three coding models, one key.', fullscreen = false } = Astro.props;
const fullTitle = title ? `${title} · Estro` : 'Estro';
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080c" />
    <script is:inline data-astro-rerun set:html={HEAD_SCRIPT} />
    <ClientRouter />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[{ fullscreen }]}>
    <FxBackground client:only="preact" transition:persist="fx" />
    <slot />
  </body>
</html>
<style is:global>
  body.fullscreen { height: 100dvh; overflow: hidden; display: flex; flex-direction: column; }
</style>
