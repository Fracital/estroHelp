{
  "manifest_version": 3,
  "name": "goldenticket z.ai captcha bridge",
  "version": "0.1.0",
  "description": "Mints chat.z.ai Aliyun captcha tokens for the goldenticket proxy in this browser.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.z.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.z.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html",
  "web_accessible_resources": [
    {
      "resources": ["zai-page.js"],
      "matches": ["https://chat.z.ai/*"]
    }
  ],
  "action": {
    "default_title": "goldenticket z.ai bridge",
    "default_popup": "status.html"
  }
}
